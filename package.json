{
  "name": "mirror-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && node scripts/build-extension.mjs",
    "test:extension": "vitest run --config extension/vitest.config.ts",
    "test:e2e:extension": "node extension/tests/e2e/run.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "lucide": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/chrome": "^0.1.32",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
